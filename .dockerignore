# Docker 构建忽略文件
# 控制哪些文件不会复制到 Docker 镜像

# ============================================
# Git 相关
# ============================================
.git
.gitignore
.gitattributes

# ============================================
# 构建产物（已在镜像中生成）
# ============================================
orange.exe
orange
*.exe
*.dll
*.so
*.dylib

# 前端构建产物（API 镜像不需要）
frontend/dist
frontend/node_modules
frontend/.vite
frontend/.eslintcache

# ============================================
# 数据库文件（不应打包进镜像）
# ============================================
*.db
*.sqlite
*.sqlite3
orange.db
backup*.db

# ============================================
# 配置文件（包含敏感信息）
# ============================================
.env
.env.local
.env.production
*.env

# ============================================
# 日志文件（不应打包进镜像）
# ============================================
logs/
*.log

# ============================================
# 测试和文档
# ============================================
*_test.go
*_test.*
test/
tests/
coverage.out
coverage.html

*.md
!README.md
CHANGELOG.md
CONTRIBUTING.md
DEPLOYMENT_GUIDE.md
OPTIMIZATION_TODO.md
CODE_REVIEW*.md
SECURITY*.md
FINAL_FIX_REPORT.md

swagger.json
swagger.yaml
swagger-ui/

# ============================================
# IDE 和编辑器配置
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================
# 临时文件
# ============================================
tmp/
temp/
*.tmp
*.bak
*.backup

# ============================================
# Wails 特定文件（前端已嵌入）
# ============================================
build/
wails.json
build/bin/
build/darwin/
build/windows/
build/linux/

# ============================================
# CI/CD 配置（不需要在镜像中）
# ============================================
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile

# ============================================
# 其他
# ============================================
scripts/
Makefile
.dockerignore
Dockerfile
docker-compose.yml
